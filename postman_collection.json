{
  "info": {
    "name": "eSnse - Financial Query API",
    "description": "Collection of sample requests for the eSnse Financial Query API",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Check if the API is running"
      },
      "response": []
    },
    {
      "name": "Query - Food Spending (Last Month)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"question\": \"How much did I spend on food last month?\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/query",
          "host": ["{{base_url}}"],
          "path": ["query"]
        },
        "description": "Query total spending on food in the last month"
      },
      "response": []
    },
    {
      "name": "Query - Spending by Category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"question\": \"Show spending by category\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/query",
          "host": ["{{base_url}}"],
          "path": ["query"]
        },
        "description": "Breakdown of spending by category (food, travel, shopping, etc.)"
      },
      "response": []
    },
    {
      "name": "Query - Top Merchants (This Month)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"question\": \"Top merchants this month\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/query",
          "host": ["{{base_url}}"],
          "path": ["query"]
        },
        "description": "Show the top 5 merchants by spending this month"
      },
      "response": []
    },
    {
      "name": "Query - Average Travel Spending",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"question\": \"Average spend on travel\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/query",
          "host": ["{{base_url}}"],
          "path": ["query"]
        },
        "description": "Calculate average spending on travel"
      },
      "response": []
    },
    {
      "name": "Cache Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/cache/stats",
          "host": ["{{base_url}}"],
          "path": ["cache", "stats"]
        },
        "description": "View current cache statistics (size and cached keys)"
      },
      "response": []
    },
    {
      "name": "Query - Different User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 2,\n  \"question\": \"How much did I spend on travel?\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/query",
          "host": ["{{base_url}}"],
          "path": ["query"]
        },
        "description": "Query for a different user (user_id=2)"
      },
      "response": []
